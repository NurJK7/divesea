# Настройки сервера (не коммить реальные секреты в git)
PORT=3000
DB_FILE=divesea.db
# Разрешённые источники для CORS через запятую (3000 — сам сервер, 5500 — Live Server в VS Code)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
STARTING_BALANCE=10
# true, если сайт открыт по HTTPS
COOKIE_SECURE=false
